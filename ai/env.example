# CITY GYM / AI - model paths, recognition and processing limits
# Copy ai/env.example to ai/.env.
# Configuration contract for the future .NET host; the current CLI does NOT load .env.
# AI is an in-process C# library, NOT a separate HTTP service.
# The future BE launcher will load be/.env + ai/.env into its process environment.

# Model directory (change when moving the project to another machine).
# Files: face_detection_yunet_2023mar.onnx and face_recognition_sface_2021dec.onnx
Recognition__ModelDirectory="C:/Users/Acer/Downloads/City Gym Face Recognition/ai/models"

# Recognition workers owned by the .NET host; one FaceEngine per worker.
Recognition__WorkerCount=2
Recognition__QueueCapacity=16
# Includes queue wait + inference; less than FE's 30000 ms request timeout.
Recognition__RequestTimeoutSeconds=25

# Illustrative cosine threshold; must be calibrated against real City Gym images.
Recognition__SimilarityThreshold=0.5

# Image constraints matching current FE/AI; BE must apply them before processing.
# Current engine limits remain hard-coded until configuration binding is implemented.
Uploads__MaxImageBytes=10485760
Uploads__MaxImagePixels=24000000

# Fixed by code/model, not editable environment options:
# model = opencv-sface-2021dec
# pipeline = yunet2023mar-similarity5-sface128-v1
# feature = 128 float32 values / 512 bytes
# detection threshold = 0.9; detection canvas = 640x640; aligned face = 112x112
# No SQL credentials, auth secrets or persistent image-storage paths belong here.
