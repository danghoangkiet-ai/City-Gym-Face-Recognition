<Project>
  <!-- The package analyzer requires Roslyn 4.14; .NET 8 SDK ships Roslyn 4.11. Keep built-in analyzers. -->
  <Target Name="RemoveIncompatibleOpenCvAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'OpenCvSharp.Analyzers'" />
    </ItemGroup>
  </Target>
</Project>
