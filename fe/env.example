# CITY GYM / FE - public UI and local preview configuration only
# Copy fe/env.example to fe/.env.
# Proposed settings: the current static server/browser code does NOT load .env yet.
# A future launcher must read only approved FE keys and expose public UI settings.
# Never place database passwords, Manager passwords, tokens or Device/Admin Keys here.

# Local Node preview server (demo only, not a backend API proxy).
FE__Host=127.0.0.1
FE__Port=5173

# Public browser settings. API uses the SAME origin as the frontend.
# When hosted by .NET at localhost:5088, /api resolves to localhost:5088/api.
FE__ApiBasePath=/api
FE__RequestTimeoutMilliseconds=30000
# demo = explicitly simulated recognition; api = real calls, requires BE.
FE__DefaultMode=demo

# No separate API hostname or CORS switch is needed for same-origin deployment.
# SQL/session/cookies/static hosting paths: be/env.example.
# Models/workers/threshold/image limits: ai/env.example.
