# CITY GYM / BE - API, database and Manager authentication
# Copy be/env.example to be/.env and replace CHANGE_ME values.
# ASP.NET Core reads process environment variables, NOT .env files automatically.
# A launcher/.env loader will be wired when the backend is implemented.
# Double underscore maps to nested .NET configuration: Auth__SessionHours -> Auth:SessionHours.
# Custom keys below are the proposed BE contract, not yet consumed by an API.
# AI settings are in ai/env.example. Public frontend settings are in fe/env.example.
# The future BE launcher must also load ai/.env, since AI runs inside the .NET process.

# 1. ASP.NET Core host (serve management FE and /api on the SAME origin)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5088
AllowedHosts=localhost;127.0.0.1

# 2. Microsoft SQL Server - REQUIRED: replace server, database and credentials.
# SQL authentication example; use a dedicated application login, not sa.
# TrustServerCertificate=True is for local SQL certificates only.
ConnectionStrings__CityGym="Server=localhost,1433;Database=CityGymFaceLocal;User Id=CHANGE_ME_SQL_USER;Password=CHANGE_ME_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15;"
# Alternative Windows authentication: replace the active line above, do not enable both.
# ConnectionStrings__CityGym="Server=localhost;Database=CityGymFaceLocal;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15;"
Database__CommandTimeoutSeconds=30
# Keep schema changes explicit, particularly when connecting to an existing City Gym DB.
Database__ApplyMigrationsOnStartup=false

# 3. First Manager account - enable only for the initial controlled bootstrap.
# The BE must hash this password and must NEVER reset an existing account on startup.
Bootstrap__Manager__Enabled=false
Bootstrap__Manager__Email=manager@citygym.local
Bootstrap__Manager__DisplayName="City Gym Manager"
Bootstrap__Manager__Password=CHANGE_ME_UNIQUE_MANAGER_PASSWORD
# Separate demo identities/terminals; leave disabled for an existing database.
Bootstrap__DemoData__Enabled=false

# 4. Manager authentication: HttpOnly session cookie + CSRF, no JWT secret required.
Auth__CookieName=CityGym.Management
Auth__SessionHours=8
Auth__SlidingExpiration=false
Auth__CookieSameSite=Lax
# SameAsRequest supports local HTTP. Use Always with HTTPS outside local development.
Auth__CookieSecurePolicy=SameAsRequest
Auth__CsrfHeaderName=X-CSRF-Token
Auth__LoginMaxFailedAttempts=5
Auth__LoginLockoutMinutes=15

# 5. ASP.NET Data Protection - persist cookie/antiforgery encryption keys.
# Absolute paths avoid ambiguity about the .NET ContentRoot directory.
DataProtection__ApplicationName=CityGym.FaceRecognition
DataProtection__KeysDirectory="C:/Users/Acer/Downloads/City Gym Face Recognition/.local/data-protection"

# 6. Frontend static files - /api and FE must share the BE origin.
# The Node server on port 5173 is a demo server and does not proxy the BE.
Frontend__Enabled=true
Frontend__RootDirectory="C:/Users/Acer/Downloads/City Gym Face Recognition/fe"

# 7. HTTP request limit (file/image limits are in ai/env.example).
# Leave room for multipart boundaries and metadata above the 10 MiB file limit.
Uploads__MaxRequestBodyBytes=11534336

# 8. Diagnostics - BE must exclude passwords, cookies, keys, image bodies and vectors from logs.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

# Device credentials are per-terminal records, stored HASHED in SQL Server.
# Manager FE does not need Device Key/Admin Key in env or frontend storage.
# Provision kiosk/service credentials separately if that integration is added later.
